{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "mcp": {
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "agent-browser": {
      "type": "local",
      "command": ["agent-browser", "mcp"],
      "enabled": true
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ]
}
