{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp"]
      }
    }
  },
  "plugins": ["@dietrichgebert/ponytail"]
}
