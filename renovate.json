{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["macos"],
      "matchFileNames": [".github/workflows/**"],
      "allowedVersions": "/^15-intel$/"
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    }
  ]
}
