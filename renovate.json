{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["macos"],
      "matchFileNames": [".github/workflows/**"],
      "allowedVersions": "/^15-intel$/"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * *"]
  }
}
